# Habilita solamente el panel local de demostracion. Nunca usar en produccion.
CREER_ADMIN_PREVIEW=false

# presentation muestra PUBLICADO y PENDIENTE con precios vacíos.
# Cambiar a published al abrir el catálogo definitivo al público.
CREER_CATALOG_MODE=presentation

# Apps Script implementado como aplicación web. La web lo usa para LEER el
# catálogo y para REGISTRAR cotizaciones, siempre desde el servidor.
# La planilla debe quedar PRIVADA (sin "cualquier persona con el enlace").
GOOGLE_QUOTE_WEB_APP_URL=
GOOGLE_QUOTE_API_TOKEN=

# Copiar desde Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
